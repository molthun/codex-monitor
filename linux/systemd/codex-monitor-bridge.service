[Unit]
Description=CodexMonitor hardware bridge (writes sensors.json for the GNOME widget)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/codex-monitor/codex-bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
